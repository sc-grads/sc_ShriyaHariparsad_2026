        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Transform and Move Data"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{284955A1-8DEF-4A02-9572-494EB138426C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Transform and Move Data"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A9D24844-C830-4B36-A5E6-180228CEB33A}"
              SQLTask:SqlStatementSource="USE TimesheetDB_SH;&#xA;SET NOCOUNT ON;&#xA;&#xA;&#xA;DECLARE @MergeOutput TABLE&#xA;(&#xA;    ActionType NVARCHAR(20),&#xA;    SourceFile NVARCHAR(500)&#xA;);&#xA;&#xA;DECLARE @CurrentFile NVARCHAR(500);&#xA;SET @CurrentFile = ?; &#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Staging_Table WHERE SourceFileName = @CurrentFile) AND @CurrentFile IS NOT NULL&#xA;BEGIN&#xA;    INSERT INTO dbo.Audit_Log (SourceFile, LoadDate, UserAccount, RowsProcessed, InsertsProcessed, UpdatesProcessed, DeletesProcessed, SkippedRows, Status)&#xA;    VALUES (@CurrentFile, GETDATE(), SUSER_SNAME(), 0, 0, 0, 1, 0, 'Source File Deleted from Disk');&#xA;END;&#xA;&#xA;-- Automatically splits the Excel filename token into First Name and Last Name columns cleanly&#xA;INSERT INTO dbo.Employee (EmployeeFirstName, EmployeeLastName)&#xA;SELECT DISTINCT &#xA;    -- 1. Grab everything before the first space as the First Name&#xA;    LEFT(CleanedFullName, CHARINDEX(' ', CleanedFullName) - 1) AS EmployeeFirstName,&#xA;    -- 2. Grab everything after the first space as the Last Name&#xA;    SUBSTRING(CleanedFullName, CHARINDEX(' ', CleanedFullName) + 1, LEN(CleanedFullName)) AS EmployeeLastName&#xA;FROM (&#xA;    SELECT DISTINCT &#xA;        REPLACE(&#xA;            CASE &#xA;                WHEN CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) &gt; 0 &#xA;                THEN LEFT(JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) - 1)&#xA;                ELSE JustFile.FileNameOnly&#xA;            END, &#xA;            '_', &#xA;            ' '&#xA;        ) AS CleanedFullName&#xA;    FROM dbo.Staging_Table r&#xA;    CROSS APPLY (&#xA;        SELECT SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) AS FileNameOnly&#xA;    ) JustFile&#xA;    WHERE r.SourceFileName = @CurrentFile&#xA;) AS ExtractedNames&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dbo.Employee emp &#xA;    WHERE emp.EmployeeFirstName = LEFT(CleanedFullName, CHARINDEX(' ', CleanedFullName) - 1)&#xA;      AND emp.EmployeeLastName = SUBSTRING(CleanedFullName, CHARINDEX(' ', CleanedFullName) + 1, LEN(CleanedFullName))&#xA;);&#xA;&#xA;&#xA;INSERT INTO dbo.Client (ClientName)&#xA;SELECT DISTINCT ISNULL(NULLIF(TRIM(Client), ''), 'Internal / General')&#xA;FROM dbo.Staging_Table&#xA;WHERE SourceFileName = @CurrentFile &#xA;  AND Client IS NOT NULL &#xA;  AND ISNULL(NULLIF(TRIM(Client), ''), 'Internal / General') NOT IN (SELECT ClientName FROM dbo.Client);&#xA;&#xA;WITH TargetCTE AS (&#xA;    SELECT t.*,&#xA;        ROW_NUMBER() OVER (&#xA;            PARTITION BY t.EmployeeID, t.WorkDate, t.ClientID, ISNULL(t.[Description], '')&#xA;            ORDER BY t.StartTime, t.EndTime, t.TimesheetID&#xA;        ) AS RowSeq&#xA;    FROM dbo.Timesheet t&#xA;    WHERE t.EmployeeID IN (&#xA;          SELECT emp.EmployeeID &#xA;          FROM dbo.Staging_Table r&#xA;          --  FIXED: Changed 'emp.EmployeeName' to the stitched First and Last name fields inside TargetCTE&#xA;          JOIN dbo.Employee emp ON (emp.EmployeeFirstName + ' ' + emp.EmployeeLastName) = REPLACE(CASE WHEN CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999)) + 1) &gt; 0 THEN LEFT(SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999)) + 1) - 1) ELSE SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) END, '_', ' ')&#xA;          WHERE r.SourceFileName = @CurrentFile&#xA;      )&#xA;      AND DATEPART(month, t.WorkDate) IN (SELECT DISTINCT DATEPART(month, TRY_CAST([Date] AS DATE)) FROM dbo.Staging_Table WHERE SourceFileName = @CurrentFile AND [Date] IS NOT NULL)&#xA;      AND DATEPART(year, t.WorkDate) IN (SELECT DISTINCT DATEPART(year, TRY_CAST([Date] AS DATE)) FROM dbo.Staging_Table WHERE SourceFileName = @CurrentFile AND [Date] IS NOT NULL)&#xA;),&#xA;SourceCTE AS (&#xA;    SELECT &#xA;        emp.EmployeeID, &#xA;        cli.ClientID,   &#xA;        TRY_CAST(r.[Date] AS DATE) AS WorkDate,&#xA;        r.[D_of_Week] AS DayOfWeek,&#xA;        ISNULL(TRIM(r.[Description]), '') AS [Description], &#xA;        ISNULL(NULLIF(TRIM(r.[Billable_or_NonBillable]), ''), 'Non-Billable') AS BillableOrNonBillable,&#xA;        r.[Comments],&#xA;        CONVERT(TIME(0), TRY_CAST(r.[Total_Hours] + ':00' AS TIME)) AS HoursWorked,&#xA;        CONVERT(TIME(0), TRY_CAST(r.[Start_Time] AS TIME)) AS StartTime,&#xA;        CONVERT(TIME(0), TRY_CAST(r.[End_Time] AS TIME)) AS EndTime,&#xA;        ROW_NUMBER() OVER (&#xA;            PARTITION BY emp.EmployeeID, TRY_CAST(r.[Date] AS DATE), cli.ClientID, ISNULL(TRIM(r.[Description]), '')&#xA;            ORDER BY CONVERT(TIME(0), TRY_CAST(r.[Start_Time] AS TIME)), CONVERT(TIME(0), TRY_CAST(r.[End_Time] AS TIME))&#xA;        ) AS RowSeq&#xA;    FROM dbo.Staging_Table r&#xA;    -- Stitched first and last name columns together for Source data extraction mapping&#xA;    JOIN dbo.Employee emp ON (emp.EmployeeFirstName + ' ' + emp.EmployeeLastName) = REPLACE(CASE WHEN CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999)) + 1) &gt; 0 THEN LEFT(SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999)) + 1) - 1) ELSE SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) END, '_', ' ')&#xA;    JOIN dbo.Client cli ON cli.ClientName = ISNULL(NULLIF(TRIM(r.Client), ''), 'Internal / General')&#xA;    WHERE r.SourceFileName = @CurrentFile &#xA;      AND r.[Date] IS NOT NULL &#xA;      AND r.[Description] NOT LIKE '%Leave%'          &#xA;      AND r.[Description] NOT LIKE '%Public Holiday%' &#xA;      AND (r.[Description] IS NOT NULL OR r.[Total_Hours] &lt;&gt; '0:00')&#xA;)&#xA;MERGE TargetCTE AS Target&#xA;USING SourceCTE AS Source&#xA;ON&#xA;(&#xA;    Target.EmployeeID = Source.EmployeeID&#xA;    AND Target.WorkDate = Source.WorkDate&#xA;    AND Target.ClientID = Source.ClientID&#xA;    AND ISNULL(Target.[Description], '') = Source.[Description]&#xA;    AND Target.RowSeq = Source.RowSeq&#xA;)&#xA;WHEN MATCHED AND (&#xA;       Target.BillableOrNonBillable &lt;&gt; Source.BillableOrNonBillable&#xA;    OR ISNULL(Target.Comments, '')  &lt;&gt; ISNULL(Source.Comments, '')&#xA;    OR ISNULL(Target.HoursWorked, '00:00:00') &lt;&gt; ISNULL(Source.HoursWorked, '00:00:00') -- FIXED: TotalHours -&gt; HoursWorked&#xA;    OR ISNULL(Target.StartTime, '00:00:00')  &lt;&gt; ISNULL(Source.StartTime, '00:00:00')&#xA;    OR ISNULL(Target.EndTime, '00:00:00')    &lt;&gt; ISNULL(Source.EndTime, '00:00:00')&#xA;)&#xA;THEN UPDATE SET&#xA;    Target.BillableOrNonBillable = Source.BillableOrNonBillable,&#xA;    Target.Comments              = Source.Comments,&#xA;    Target.HoursWorked           = Source.HoursWorked, -- FIXED: Hours_Worked -&gt; HoursWorked&#xA;    Target.StartTime             = Source.StartTime,&#xA;    Target.EndTime               = Source.EndTime,&#xA;    Target.DayOfWeek             = Source.DayOfWeek&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;INSERT (EmployeeID, ClientID, WorkDate, DayOfWeek, [Description], BillableOrNonBillable, Comments, HoursWorked, StartTime, EndTime)&#xA;VALUES (Source.EmployeeID, Source.ClientID, Source.WorkDate, Source.DayOfWeek, Source.[Description], Source.BillableOrNonBillable, Source.Comments, Source.HoursWorked, Source.StartTime, Source.EndTime) -- FIXED: TotalHours -&gt; HoursWorked&#xA;&#xA;WHEN NOT MATCHED BY SOURCE THEN&#xA;DELETE&#xA;&#xA;OUTPUT $action, @CurrentFile INTO @MergeOutput;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DECLARE @TSInserts INT, @TSUpdates INT, @TSDeletes INT, @LVInserts INT = 0;&#xA;SELECT @TSInserts = COUNT(CASE WHEN ActionType = 'INSERT' THEN 1 END) FROM @MergeOutput;&#xA;SELECT @TSUpdates = COUNT(CASE WHEN ActionType = 'UPDATE' THEN 1 END) FROM @MergeOutput;&#xA;SELECT @TSDeletes = COUNT(CASE WHEN ActionType = 'DELETE' THEN 1 END) FROM @MergeOutput; &#xA;&#xA;INSERT INTO dbo.Leave (EmployeeID, LeaveDate, LeaveType) &#xA;SELECT SourceLeave.EmployeeID, SourceLeave.LeaveDate, SourceLeave.LeaveType --  Removed SourceLeave.TotalHours&#xA;FROM (&#xA;    SELECT &#xA;        emp.EmployeeID, &#xA;        TRY_CAST(r.[Date] AS DATE) AS LeaveDate,&#xA;        TRIM(r.[Description]) AS LeaveType&#xA;    FROM dbo.Staging_Table r&#xA;    -- Stitched first and last name columns together for Leave mapping lookups&#xA;    JOIN dbo.Employee emp ON (emp.EmployeeFirstName + ' ' + emp.EmployeeLastName) = REPLACE(CASE WHEN CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999)) + 1) &gt; 0 THEN LEFT(SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999), CHARINDEX('_', SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999)) + 1) - 1) ELSE SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) END, '_', ' ')&#xA;    WHERE r.SourceFileName = @CurrentFile AND r.[Date] IS NOT NULL AND r.[Description] LIKE '%Leave%'&#xA;) AS SourceLeave&#xA;WHERE NOT EXISTS (&#xA;    -- 💡 Removed TotalHours check from the safety filter&#xA;    SELECT 1 FROM dbo.Leave target &#xA;    WHERE target.EmployeeID = SourceLeave.EmployeeID &#xA;      AND target.LeaveDate = SourceLeave.LeaveDate &#xA;      AND target.LeaveType = SourceLeave.LeaveType&#xA;);&#xA;SET @LVInserts = @@ROWCOUNT;&#xA;&#xA;INSERT INTO dbo.Audit_Log (SourceFile, LoadDate, UserAccount, RowsProcessed, InsertsProcessed, UpdatesProcessed, DeletesProcessed, SkippedRows, Status)&#xA;VALUES (&#xA;    @CurrentFile,&#xA;    GETDATE(),&#xA;    SUSER_SNAME(),&#xA;    (SELECT COUNT(*) FROM dbo.Staging_Table WHERE SourceFileName = @CurrentFile),&#xA;    @TSInserts + @LVInserts,&#xA;    @TSUpdates,&#xA;    @TSDeletes,&#xA;    (SELECT COUNT(*) FROM dbo.Staging_Table WHERE SourceFileName = @CurrentFile) - (@TSInserts + @LVInserts + @TSUpdates),&#xA;    CASE WHEN @TSDeletes &gt; 0 THEN 'Records Deleted' WHEN @TSUpdates &gt; 0 THEN 'Records Updated' ELSE 'Success' END&#xA;);&#xA;&#xA;TRUNCATE TABLE dbo.Staging_Table;&#xA;SET @CurrentFile = NULL;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::CurrentFilePath"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="500" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
