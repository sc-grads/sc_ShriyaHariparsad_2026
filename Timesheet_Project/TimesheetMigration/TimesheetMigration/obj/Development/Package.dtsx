    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{377D1400-CAF3-4E11-8E47-DCFF04275093}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT * FROM [&quot; + &#xA;((FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;march&quot;, 1) &gt; 0) ? &quot;Mar&quot; : &#xA; ((FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;april&quot;, 1) &gt; 0) ? &quot;Apr&quot; : &#xA;  ((FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;may&quot;, 1) &gt; 0) ? &quot;May&quot; : &quot;Apr&quot;))) &#xA;+ &quot;$A8:Z]&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TargetSheetName">
      <DTS:VariableValue
        DTS:DataType="8">SELECT * FROM [Apr$A8:Z]</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Check for deleted files"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E9EB96CE-0BF7-496E-8BF4-95ADDEB1EAD7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check for deleted files"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A9D24844-C830-4B36-A5E6-180228CEB33A}"
          SQLTask:SqlStatementSource="USE TimesheetDB_SH;&#xA;SET NOCOUNT ON;&#xA;&#xA;-- 1. Create a temporary memory table to log what files successfully processed right now&#xA;DECLARE @ActiveFilesOnDisk TABLE (SourceFile NVARCHAR(500));&#xA;&#xA;-- Populate it with the files that successfully ran during this exact package run window pass&#xA;INSERT INTO @ActiveFilesOnDisk (SourceFile)&#xA;SELECT DISTINCT SourceFile&#xA;FROM dbo.Audit_Log&#xA;WHERE LoadDate &gt;= DATEADD(second, -60, GETDATE())&#xA;  AND Status &lt;&gt; 'Source File Deleted from Disk'; -- Ensure we only grab actual active processing runs&#xA;&#xA;-- 2. Log files that exist in your production database history but were completely bypassed &#xA;-- because their physical Excel workbook is missing from the folder.&#xA;INSERT INTO dbo.Audit_Log (SourceFile, LoadDate, UserAccount, RowsProcessed, InsertsProcessed, UpdatesProcessed, DeletesProcessed, SkippedRows, Status)&#xA;SELECT DISTINCT &#xA;    historical.SourceFile, &#xA;    GETDATE(), &#xA;    SUSER_SNAME(), &#xA;    0, &#xA;    0, &#xA;    0, &#xA;    0, &#xA;    0, &#xA;    'Source File Deleted from Disk'&#xA;FROM dbo.Audit_Log historical&#xA;LEFT JOIN @ActiveFilesOnDisk active ON active.SourceFile = historical.SourceFile&#xA;WHERE active.SourceFile IS NULL&#xA;  AND historical.Status NOT LIKE 'Source File Deleted%'&#xA;  -- THE SAFETY SHIELD: Keeps your deletion alert locked for THIS RUN pass, &#xA;  -- but allows historical logs to remain completely untouched in the table permanently!&#xA;  AND historical.SourceFile NOT IN (&#xA;      SELECT DISTINCT SourceFile &#xA;      FROM dbo.Audit_Log &#xA;      WHERE Status = 'Source File Deleted from Disk'&#xA;  );&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;SELECT t.*&#xA;FROM dbo.Timesheet t&#xA;JOIN dbo.Employee emp ON emp.EmployeeID = t.EmployeeID&#xA;JOIN dbo.Audit_Log del_log ON del_log.Status = 'Source File Deleted from Disk'&#xA;WHERE TRY_CAST(TRIM(REPLACE(&#xA;        CASE &#xA;            WHEN CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999), CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999)) + 1) &gt; 0 &#xA;            THEN LEFT(SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999), CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999), CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999)) + 1) - 1) &#xA;            ELSE SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999) &#xA;        END, &#xA;        '_', &#xA;        ' '&#xA;      )) AS NVARCHAR(500)) = TRY_CAST(TRIM(emp.EmployeeFirstName + ' ' + emp.EmployeeLastName) AS NVARCHAR(500))&#xA;  AND (&#xA;       (del_log.SourceFile LIKE '%_March%' AND DATEPART(month, t.WorkDate) = 3) OR&#xA;       (del_log.SourceFile LIKE '%_April%' AND DATEPART(month, t.WorkDate) = 4) OR&#xA;       (del_log.SourceFile LIKE '%_May%'   AND DATEPART(month, t.WorkDate) = 5)&#xA;  )&#xA;  AND DATEPART(year, t.WorkDate) = 2026;&#xA;&#xA;&#xA;SELECT l.*&#xA;FROM dbo.Leave l&#xA;JOIN dbo.Employee emp ON emp.EmployeeID = l.EmployeeID&#xA;JOIN dbo.Audit_Log del_log ON del_log.Status = 'Source File Deleted from Disk'&#xA;WHERE TRY_CAST(TRIM(REPLACE(&#xA;        CASE &#xA;            WHEN CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999), CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999)) + 1) &gt; 0 &#xA;            THEN LEFT(SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999), CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999), CHARINDEX('_', SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999)) + 1) - 1) &#xA;            ELSE SUBSTRING(del_log.SourceFile, LEN(del_log.SourceFile) - CHARINDEX('\', REVERSE(del_log.SourceFile)) + 2, 999) &#xA;        END, &#xA;        '_', &#xA;        ' '&#xA;      )) AS NVARCHAR(500)) = TRY_CAST(TRIM(emp.EmployeeFirstName + ' ' + emp.EmployeeLastName) AS NVARCHAR(500))&#xA;  AND (&#xA;       (del_log.SourceFile LIKE '%_March%' AND DATEPART(month, l.LeaveDate) = 3) OR&#xA;       (del_log.SourceFile LIKE '%_April%' AND DATEPART(month, l.LeaveDate) = 4) OR&#xA;       (del_log.SourceFile LIKE '%_May%'   AND DATEPART(month, l.LeaveDate) = 5)&#xA;  )&#xA;  AND DATEPART(year, l.LeaveDate) = 2026;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create Database and Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1879AB53-369D-40E8-B663-4F547074F633}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Database and Tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D910C7F2-2B3F-4613-9AC1-FE89578A3CC9}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT name FROM sys.databases WHERE name = N'TimesheetDB_SH')&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetDB_SH;&#xA;END;&#xA;GO&#xA;&#xA;USE TimesheetDB_SH;&#xA;GO&#xA;&#xA;-- 1. STAGING TABLE &#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'dbo.Staging_Table') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Staging_Table (&#xA;        StagingID INT IDENTITY(1,1) NOT NULL,&#xA;        [Date] NVARCHAR(50),&#xA;        [D_of_Week] NVARCHAR(50),&#xA;        [Client] NVARCHAR(250),&#xA;        [Description] NVARCHAR(MAX),&#xA;        [Billable_or_NonBillable] NVARCHAR(50),&#xA;        [Comments] NVARCHAR(MAX),&#xA;        [Total_Hours] NVARCHAR(50),&#xA;        [Start_Time] NVARCHAR(50),&#xA;        [End_Time] NVARCHAR(50),&#xA;        [SourceFileName] NVARCHAR(500), &#xA;        [LoadTimestamp] DATETIME DEFAULT GETDATE(),&#xA;        CONSTRAINT PK_Staging_Table PRIMARY KEY NONCLUSTERED (StagingID)&#xA;    );&#xA;    &#xA;    CREATE CLUSTERED INDEX IX_Staging_Chronological &#xA;    ON dbo.Staging_Table (SourceFileName ASC, [Date] ASC, [Start_Time] ASC);&#xA;END;&#xA;&#xA;-- 2. AUDIT LOG TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'dbo.Audit_Log') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Audit_Log (&#xA;        AuditID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        SourceFile NVARCHAR(250) NOT NULL, &#xA;        LoadDate DATETIME DEFAULT GETDATE(),&#xA;        UserAccount NVARCHAR(100) NULL,&#xA;        RowsProcessed INT,&#xA;        InsertsProcessed INT NULL,&#xA;        UpdatesProcessed INT NULL,&#xA;        DeletesProcessed INT NULL,&#xA;        SkippedRows INT NULL,&#xA;        Status NVARCHAR(50),&#xA;        ErrorMessage NVARCHAR(MAX) NULL&#xA;    );&#xA;END;&#xA;&#xA;-- 3. EMPLOYEE TABLE (Updated with Split Name Attributes)&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'dbo.Employee') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Employee (&#xA;        EmployeeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeFirstName NVARCHAR(250) NOT NULL,&#xA;        EmployeeLastName NVARCHAR(250) NOT NULL,&#xA;        CONSTRAINT UC_Employee_FullName UNIQUE (EmployeeFirstName, EmployeeLastName)&#xA;    );&#xA;END;&#xA;&#xA;-- 4. CLIENT TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'dbo.Client') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Client (&#xA;        ClientID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ClientName NVARCHAR(250) UNIQUE NOT NULL&#xA;    );&#xA;END;&#xA;&#xA;-- 5. FINAL TIMESHEET TABLE (Completely clean of all tracking columns)&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'dbo.Timesheet') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Timesheet (&#xA;        TimesheetID INT IDENTITY(1,1) NOT NULL,&#xA;        EmployeeID INT NOT NULL FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        ClientID INT NOT NULL FOREIGN KEY REFERENCES dbo.Client(ClientID), &#xA;        WorkDate DATE NOT NULL,&#xA;        DayOfWeek NVARCHAR(50),&#xA;        [Description] NVARCHAR(MAX), &#xA;        BillableOrNonBillable NVARCHAR(50) NOT NULL, &#xA;        Comments NVARCHAR(MAX),&#xA;        HoursWorked TIME(0),&#xA;        StartTime TIME(0),&#xA;        EndTime TIME(0),&#xA;        CONSTRAINT PK_Timesheet PRIMARY KEY NONCLUSTERED (TimesheetID)&#xA;    );&#xA;    &#xA;    CREATE CLUSTERED INDEX IX_Timesheet_Chronological &#xA;    ON dbo.Timesheet (EmployeeID ASC, WorkDate ASC, StartTime ASC);&#xA;END;&#xA;&#xA;-- 6. LEAVE TRACKING TABLE &#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'dbo.Leave') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Leave (&#xA;        LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        LeaveDate DATE NOT NULL,&#xA;        LeaveType NVARCHAR(150) NOT NULL                 &#xA;    );&#xA;END;                     &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Foreach Loop Container"
