  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Create Database and Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1879AB53-369D-40E8-B663-4F547074F633}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Database and Tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F4BE3D0A-BD9D-4AC7-9943-E0DD33FBB423}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT name FROM sys.databases WHERE name = N'TimesheetDB')&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetDB;&#xA;END&#xA;GO&#xA;&#xA;EXEC('&#xA;USE TimesheetDB;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = ''dbo'') EXEC('''+ 'CREATE SCHEMA dbo' +''');&#xA;&#xA;-- 1. STAGING TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Staging_Table'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Staging_Table (&#xA;        StagingID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        [Date] NVARCHAR(50),&#xA;        [D_of_Week] NVARCHAR(50),&#xA;        [Client] NVARCHAR(250),&#xA;        [Description] NVARCHAR(MAX),&#xA;        [Billable_or_NonBillable] NVARCHAR(50),&#xA;        [Comments] NVARCHAR(MAX),&#xA;        [Total_Hours] NVARCHAR(50),&#xA;        [Start_Time] NVARCHAR(50),&#xA;        [End_Time] NVARCHAR(50),&#xA;        [SourceFileName] NVARCHAR(500), &#xA;        [LoadTimestamp] DATETIME DEFAULT GETDATE()&#xA;    );&#xA;END&#xA;&#xA;-- 2. AUDIT LOG TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Audit_Log'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Audit_Log (&#xA;        AuditID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        SourceFile NVARCHAR(250) UNIQUE,&#xA;        LoadDate DATETIME DEFAULT GETDATE(),&#xA;        RowsProcessed INT,&#xA;        InsertsProcessed INT NULL,&#xA;        UpdatesProcessed INT NULL,&#xA;        DeletesProcessed INT NULL,&#xA;        SkippedRows INT NULL,&#xA;        Status NVARCHAR(50),&#xA;        ErrorMessage NVARCHAR(MAX) NULL&#xA;    );&#xA;END&#xA;&#xA;-- 3. EMPLOYEE TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Employee'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Employee (&#xA;        EmployeeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeName NVARCHAR(250) UNIQUE NOT NULL&#xA;    );&#xA;END&#xA;&#xA;-- 4. CLIENT TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Client'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Client (&#xA;        ClientID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ClientName NVARCHAR(250) UNIQUE NOT NULL&#xA;    );&#xA;END&#xA;&#xA;-- 5. FINAL TIMESHEET TABLE &#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Timesheet'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Timesheet (&#xA;        TimesheetID INT IDENTITY(1,1) NOT NULL,&#xA;        EmployeeID INT NOT NULL FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        ClientID INT NOT NULL FOREIGN KEY REFERENCES dbo.Client(ClientID), &#xA;        EmployeeMonthCode NVARCHAR(100) NULL, --  NEW POSITION: Sitting right next to ClientID&#xA;        WorkDate DATE NOT NULL,&#xA;        DayOfWeek NVARCHAR(50),&#xA;        [Description] NVARCHAR(MAX), &#xA;        BillableOrNonBillable NVARCHAR(50) NOT NULL, &#xA;        Comments NVARCHAR(MAX),&#xA;        TotalHours TIME(0),&#xA;        StartTime TIME(0),&#xA;        EndTime TIME(0) --  AuditID column removed completely from here&#xA;    );&#xA;    ALTER TABLE dbo.Timesheet &#xA;    ADD CONSTRAINT PK_Timesheet PRIMARY KEY CLUSTERED (EmployeeID ASC, WorkDate ASC, TimesheetID ASC);&#xA;END&#xA;&#xA;-- 6. LEAVE TRACKING TABLE &#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Leave'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Leave (&#xA;        LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        AuditID INT FOREIGN KEY REFERENCES dbo.Audit_Log(AuditID), --  NEW POSITION: Sitting right next to EmployeeID&#xA;        LeaveDate DATE NOT NULL,&#xA;        LeaveType NVARCHAR(150) NOT NULL, &#xA;        TotalHours TIME(0)                  &#xA;    );&#xA;END&#xA;&#xA;&#xA;-- 7. TOTAL HOURS WORKED SUMMARY TABLE&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N''dbo.Total_Hours_Worked'') AND type in (N''U''))&#xA;BEGIN&#xA;    CREATE TABLE dbo.Total_Hours_Worked (&#xA;        EmployeeID INT NOT NULL FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        MonthName NVARCHAR(50) NOT NULL,&#xA;        TotalHoursWorked NVARCHAR(50) NOT NULL,&#xA;        CONSTRAINT PK_Total_Hours_Worked PRIMARY KEY CLUSTERED (EmployeeID ASC, MonthName ASC)&#xA;    );&#xA;END&#xA;');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
