                <path
                  refId="Package\Foreach Loop Container\Extract Excel.Paths[Derived Column Output]"
                  endId="Package\Foreach Loop Container\Extract Excel\OLE DB Destination.Inputs[OLE DB Destination Input]"
                  name="Derived Column Output"
