        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Transform and Move Data"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{284955A1-8DEF-4A02-9572-494EB138426C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Transform and Move Data"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{4213412A-DAC0-4E68-A9AE-1E71C66D30F2}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;&#xA;--  NEW SAFETY LOCK: Capture the exact, single file name currently being processed in this loop cycle&#xA;DECLARE @CurrentFile NVARCHAR(500);&#xA;SELECT TOP 1 @CurrentFile = SourceFileName FROM dbo.Staging_Table WHERE SourceFileName IS NOT NULL;&#xA;&#xA;-- 1. EXTRACT FIRST NAME AND SURNAME FROM FILENAME FOR THE REFERENCE LOOKUP TABLE&#xA;INSERT INTO dbo.Employee (EmployeeName)&#xA;SELECT DISTINCT &#xA;    REPLACE(&#xA;        CASE &#xA;            WHEN CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) &gt; 0 &#xA;            THEN LEFT(JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) - 1)&#xA;            ELSE JustFile.FileNameOnly&#xA;        END, &#xA;        '_', &#xA;        ' '&#xA;    ) AS CleanedFullName&#xA;FROM dbo.Staging_Table r&#xA;CROSS APPLY (&#xA;    SELECT SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) AS FileNameOnly&#xA;) JustFile&#xA;WHERE r.SourceFileName = @CurrentFile --  Filtered to current file only&#xA;  AND REPLACE(&#xA;        CASE &#xA;            WHEN CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) &gt; 0 &#xA;            THEN LEFT(JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) - 1)&#xA;            ELSE JustFile.FileNameOnly&#xA;        END, &#xA;        '_', &#xA;        ' '&#xA;      ) NOT IN (SELECT EmployeeName FROM dbo.Employee);&#xA;&#xA;-- 2. INSERT NEW CLIENTS INTO REFERENTIAL LOOKUP TABLE&#xA;INSERT INTO dbo.Client (ClientName)&#xA;SELECT DISTINCT ISNULL(NULLIF(TRIM(Client), ''), 'Internal / General')&#xA;FROM dbo.Staging_Table&#xA;WHERE SourceFileName = @CurrentFile --  Filtered to current file only&#xA;  AND Client IS NOT NULL &#xA;  AND ISNULL(NULLIF(TRIM(Client), ''), 'Internal / General') NOT IN (SELECT ClientName FROM dbo.Client);&#xA;&#xA;-- 3. LOG SYSTEM TRANSACTION METRICS IN SYSTEM AUDIT LOG &#xA;INSERT INTO dbo.Audit_Log (SourceFile, Status, RowsProcessed, InsertsProcessed, UpdatesProcessed, DeletesProcessed, SkippedRows)&#xA;SELECT DISTINCT SourceFileName, 'Success', COUNT(*), 0, 0, 0, 0&#xA;FROM dbo.Staging_Table&#xA;WHERE SourceFileName = @CurrentFile --  Filtered to current file only&#xA;  AND SourceFileName NOT IN (SELECT SourceFile FROM dbo.Audit_Log)&#xA;GROUP BY SourceFileName;&#xA;&#xA;-- DECLARE LOCAL COUNTERS TO HOLD THE ROW COUNTS NATIVELY&#xA;DECLARE @TSInserts INT = 0;&#xA;DECLARE @LVInserts INT = 0;&#xA;&#xA;-- 4. TIMESHEET INSERT&#xA;INSERT INTO dbo.Timesheet (EmployeeID, ClientID, EmployeeMonthCode, WorkDate, DayOfWeek, [Description], BillableOrNonBillable, Comments, TotalHours, StartTime, EndTime)&#xA;SELECT &#xA;    SourceData.EmployeeID,&#xA;    SourceData.ClientID,&#xA;    SourceData.EmployeeMonthCode,&#xA;    SourceData.WorkDate,&#xA;    SourceData.DayOfWeek,&#xA;    SourceData.[Description],&#xA;    SourceData.BillableOrNonBillable,&#xA;    SourceData.Comments,&#xA;    SourceData.TotalHours,&#xA;    SourceData.StartTime,&#xA;    SourceData.EndTime&#xA;FROM (&#xA;    SELECT &#xA;        emp.EmployeeID, &#xA;        cli.ClientID,   &#xA;        CAST(&#xA;            LEFT(CleanName.FinalFullName, 1) + &#xA;            SUBSTRING(CleanName.FinalFullName, CHARINDEX(' ', CleanName.FinalFullName) + 1, 1) + &#xA;            '-' + &#xA;            ISNULL(DATENAME(month, TRY_CAST(r.[Date] AS DATE)), 'Unknown')&#xA;        AS NVARCHAR(100)) AS EmployeeMonthCode,&#xA;        TRY_CAST(r.[Date] AS DATE) AS WorkDate,&#xA;        r.[D_of_Week] AS DayOfWeek,&#xA;        r.[Description],&#xA;        ISNULL(NULLIF(TRIM(r.[Billable_or_NonBillable]), ''), 'Non-Billable') AS BillableOrNonBillable,&#xA;        r.[Comments],&#xA;        CONVERT(TIME(0), TRY_CAST(r.[Total_Hours] + ':00' AS TIME)) AS TotalHours,&#xA;        CONVERT(TIME(0), TRY_CAST(r.[Start_Time] AS TIME)) AS StartTime,&#xA;        CONVERT(TIME(0), TRY_CAST(r.[End_Time] AS TIME)) AS EndTime&#xA;    FROM dbo.Staging_Table r&#xA;    CROSS APPLY (&#xA;        SELECT SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) AS FileNameOnly&#xA;    ) JustFile&#xA;    CROSS APPLY (&#xA;        SELECT REPLACE(&#xA;            CASE &#xA;                WHEN CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) &gt; 0 &#xA;                THEN LEFT(JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) - 1)&#xA;                ELSE JustFile.FileNameOnly&#xA;            END, &#xA;            '_', &#xA;            ' '&#xA;        ) AS FinalFullName&#xA;    ) CleanName&#xA;    JOIN dbo.Employee emp ON emp.EmployeeName = CleanName.FinalFullName&#xA;    JOIN dbo.Client cli ON cli.ClientName = ISNULL(NULLIF(TRIM(r.Client), ''), 'Internal / General')&#xA;    WHERE r.SourceFileName = @CurrentFile --  Filtered to current file only&#xA;      AND r.[Date] IS NOT NULL &#xA;      AND r.[Description] NOT LIKE '%Leave%'          &#xA;      AND r.[Description] NOT LIKE '%Public Holiday%' &#xA;      AND (r.[Description] IS NOT NULL OR r.[Total_Hours] &lt;&gt; '0:00')&#xA;) AS SourceData&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dbo.Timesheet target&#xA;    WHERE target.EmployeeID = SourceData.EmployeeID&#xA;      AND target.WorkDate = SourceData.WorkDate&#xA;      AND ISNULL(target.[Description], '') = ISNULL(SourceData.[Description], '')&#xA;      AND target.ClientID = SourceData.ClientID&#xA;);&#xA;&#xA;SET @TSInserts = @@ROWCOUNT;&#xA;&#xA;-- 4b. LEAVE INSERT (UPDATED COLUMNS SEQUENCE MAP)&#xA;INSERT INTO dbo.Leave (EmployeeID, AuditID, LeaveDate, LeaveType, TotalHours) --  Column order updated here&#xA;SELECT &#xA;    SourceLeave.EmployeeID,&#xA;    SourceLeave.AuditID, -- AuditID moved up to match&#xA;    SourceLeave.LeaveDate,&#xA;    SourceLeave.LeaveType,&#xA;    SourceLeave.TotalHours&#xA;FROM (&#xA;    SELECT &#xA;        emp.EmployeeID, &#xA;        a.AuditID,&#xA;        TRY_CAST(r.[Date] AS DATE) AS LeaveDate,&#xA;        TRIM(r.[Description]) AS LeaveType,&#xA;        CONVERT(TIME(0), TRY_CAST(ISNULL(NULLIF(r.[Total_Hours], ''), '00:00') + ':00' AS TIME)) AS TotalHours&#xA;    FROM dbo.Staging_Table r&#xA;    JOIN dbo.Audit_Log a ON r.SourceFileName = a.SourceFile&#xA;    CROSS APPLY (&#xA;        SELECT SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) AS FileNameOnly&#xA;    ) JustFile&#xA;    CROSS APPLY (&#xA;        SELECT REPLACE(&#xA;            CASE &#xA;                WHEN CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) &gt; 0 &#xA;                THEN LEFT(JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) - 1)&#xA;                ELSE JustFile.FileNameOnly&#xA;            END, &#xA;            '_', &#xA;            ' '&#xA;        ) AS FinalFullName&#xA;    ) CleanName&#xA;    JOIN dbo.Employee emp ON emp.EmployeeName = CleanName.FinalFullName&#xA;    WHERE r.SourceFileName = @CurrentFile &#xA;      AND r.[Date] IS NOT NULL &#xA;      AND r.[Description] LIKE '%Leave%'&#xA;) AS SourceLeave&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dbo.Leave target&#xA;    WHERE target.EmployeeID = SourceLeave.EmployeeID&#xA;      AND target.LeaveDate = SourceLeave.LeaveDate&#xA;      AND target.LeaveType = SourceLeave.LeaveType&#xA;);&#xA;&#xA;SET @LVInserts = @@ROWCOUNT;&#xA;&#xA;&#xA;-- 4c. UPDATE THE CENTRALISED AUDIT LOG&#xA;UPDATE dbo.Audit_Log&#xA;SET &#xA;    InsertsProcessed = @TSInserts + @LVInserts,&#xA;    UpdatesProcessed = 0,&#xA;    DeletesProcessed = 0,&#xA;    SkippedRows      = RowsProcessed - (@TSInserts + @LVInserts),&#xA;    LoadDate         = GETDATE()&#xA;WHERE SourceFile = @CurrentFile; &#xA;&#xA;-- 4d. MONTHLY SUMMARY GENERATION&#xA;WITH ValidatedRows AS (&#xA;    SELECT &#xA;        emp.EmployeeID, &#xA;        ISNULL(DATEPART(month, TRY_CAST(r.[Date] AS DATE)), 0) AS MonthNumber,&#xA;        ISNULL(DATENAME(month, TRY_CAST(r.[Date] AS DATE)), 'Unknown') AS MonthName,&#xA;        CONVERT(TIME(0), TRY_CAST(r.[Total_Hours] + ':00' AS TIME)) AS ValidatedTimeField&#xA;    FROM dbo.Staging_Table r&#xA;    CROSS APPLY (&#xA;        SELECT SUBSTRING(r.SourceFileName, LEN(r.SourceFileName) - CHARINDEX('\', REVERSE(r.SourceFileName)) + 2, 999) AS FileNameOnly&#xA;    ) JustFile&#xA;    CROSS APPLY (&#xA;        SELECT REPLACE(&#xA;            CASE &#xA;                WHEN CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) &gt; 0 &#xA;                THEN LEFT(JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly, CHARINDEX('_', JustFile.FileNameOnly) + 1) - 1)&#xA;                ELSE JustFile.FileNameOnly&#xA;            END, &#xA;            '_', &#xA;            ' '&#xA;        ) AS FinalFullName&#xA;    ) CleanName&#xA;    JOIN dbo.Employee emp ON emp.EmployeeName = CleanName.FinalFullName&#xA;    WHERE r.SourceFileName = @CurrentFile -- Filtered to current file only&#xA;      AND r.[Date] IS NOT NULL &#xA;      AND r.[Description] NOT LIKE '%Leave%'          &#xA;      AND r.[Description] NOT LIKE '%Public Holiday%' &#xA;      AND (r.[Description] IS NOT NULL OR r.[Total_Hours] &lt;&gt; '0:00')&#xA;),&#xA;CalculatedMinutes AS (&#xA;    SELECT &#xA;        EmployeeID,&#xA;        MonthNumber,&#xA;        MonthName,&#xA;        SUM((DATEPART(hour, ValidatedTimeField) * 60) + DATEPART(minute, ValidatedTimeField)) AS TotalMinutes&#xA;    FROM ValidatedRows&#xA;    WHERE MonthName &lt;&gt; 'Unknown' &#xA;      AND ValidatedTimeField IS NOT NULL&#xA;      AND ValidatedTimeField &lt;&gt; '00:00:00'&#xA;    GROUP BY EmployeeID, MonthNumber, MonthName&#xA;),&#xA;FormattedTotals AS (&#xA;    SELECT &#xA;        EmployeeID,&#xA;        MonthName,&#xA;        TotalMinutes,&#xA;        CAST(TotalMinutes / 60 AS VARCHAR(10)) + ':' + RIGHT('0' + CAST(TotalMinutes % 60 AS VARCHAR(2)), 2) AS TextHoursStamp&#xA;    FROM CalculatedMinutes&#xA;)&#xA;MERGE dbo.Total_Hours_Worked AS target&#xA;USING FormattedTotals AS source&#xA;ON (target.EmployeeID = source.EmployeeID AND target.MonthName = source.MonthName)&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET target.TotalHoursWorked = &#xA;        CAST(&#xA;            (&#xA;                (CAST(LEFT(target.TotalHoursWorked, CHARINDEX(':', target.TotalHoursWorked) - 1) AS INT) * 60) + &#xA;                CAST(SUBSTRING(target.TotalHoursWorked, CHARINDEX(':', target.TotalHoursWorked) + 1, 2) AS INT) + &#xA;                source.TotalMinutes&#xA;            ) / 60 AS VARCHAR(10)&#xA;        ) + ':' + &#xA;        RIGHT('0' + CAST(&#xA;            (&#xA;                (CAST(LEFT(target.TotalHoursWorked, CHARINDEX(':', target.TotalHoursWorked) - 1) AS INT) * 60) + &#xA;                CAST(SUBSTRING(target.TotalHoursWorked, CHARINDEX(':', target.TotalHoursWorked) + 1, 2) AS INT) + &#xA;                source.TotalMinutes&#xA;            ) % 60 AS VARCHAR(2)&#xA;        ), 2)&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (EmployeeID, MonthName, TotalHoursWorked)&#xA;    VALUES (source.EmployeeID, source.MonthName, source.TextHoursStamp);&#xA;&#xA;-- 5. TRUNCATE STAGING FOR THE NEXT ITERATION&#xA;TRUNCATE TABLE dbo.Staging_Table;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
